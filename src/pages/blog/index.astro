---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

function idToSlug(id: string): string {
  return id.replace(/^blog:/, '');
}
---

<Layout title="Blog" currentPage="blog">
  <!-- Background: looking into dark space -->
  <div class="fixed inset-0 z-0 overflow-hidden">
    <!-- Deep space gradient -->
    <div class="absolute inset-0 bg-[#05050a]"></div>

    <!-- Subtle nebula/atmosphere -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 20%, rgba(167,139,250,0.04) 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, rgba(139,108,240,0.03) 0%, transparent 50%);"></div>

    <!-- Vignette: darker edges, lighter center = window effect -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 40%, rgba(5,5,10,0.8) 100%);"></div>

    <!-- Subtle grid lines: like looking through a viewport frame -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(167,139,250,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(167,139,250,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <!-- Outer frame border -->
    <div class="absolute inset-3 md:inset-4 border border-[rgba(167,139,250,0.08)] rounded-sm pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="fade-up mb-16">
      <h1 class="text-silver-light text-3xl font-light tracking-tight md:text-4xl" style="font-weight: 300;">
        blog
      </h1>
      <p class="text-text-silver mt-3 text-sm font-light italic">things I've written down</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${idToSlug(post.id)}/`}
            class="fade-up group relative block"
            style={{ animationDelay: `${i * 0.05}s` }}
          >
            <article class="relative group">
              <div class="relative overflow-hidden rounded-2xl p-3 bg-gradient-to-b from-slate-700 via-slate-800 to-slate-900 border-2 border-slate-700 shadow-[0_0_30px_rgba(0,0,0,0.8)]">
                <div class="relative aspect-square rounded-xl overflow-hidden border border-slate-950">
                  {post.data.coverImage ? (
                    <Image
                      src={post.data.coverImage}
                      alt=""
                      width={600}
                      height={300}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-slate-800 to-slate-950 flex items-center justify-center">
                      <span class="text-slate-600 text-4xl">·</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-b from-cyan-400/10 via-transparent to-indigo-950/30 pointer-events-none"></div>
                  <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(2,6,23,0.85)] pointer-events-none"></div>
                </div>
              </div>
              <div class="mt-4 text-center">
                <time class="text-xs font-mono text-cyan-500/80">{formatDate(post.data.date)}</time>
                <h2 class="text-lg font-medium text-slate-200 mt-1">{post.data.title}</h2>
                <p class="text-text-muted text-sm mt-2 leading-relaxed line-clamp-2">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap justify-center gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-800/80 text-slate-400 border border-slate-700/50">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          </a>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="text-text-dim italic">No posts yet. Something will appear eventually.</p>
      )
    }
  </div>
</Layout>
