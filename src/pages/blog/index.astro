---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

function idToSlug(id: string): string {
  return id.replace(/^blog:/, '');
}
---

<Layout title="Blog" currentPage="blog">
  <!-- Background: looking into dark space -->
  <div class="fixed inset-0 z-0 overflow-hidden">
    <!-- Deep space gradient -->
    <div class="absolute inset-0 bg-[#05050a]"></div>
    
    <!-- Subtle nebula/atmosphere -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 20%, rgba(167,139,250,0.04) 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, rgba(139,108,240,0.03) 0%, transparent 50%);"></div>
    
    <!-- Vignette: darker edges, lighter center = window effect -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 40%, rgba(5,5,10,0.8) 100%);"></div>
    
    <!-- Subtle grid lines: like looking through a viewport frame -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(167,139,250,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(167,139,250,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    
    <!-- Outer frame border -->
    <div class="absolute inset-3 md:inset-4 border border-[rgba(167,139,250,0.08)] rounded-sm pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-2xl px-6 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="fade-up mb-12">
      <h1 class="text-silver-light text-3xl font-light tracking-tight md:text-4xl" style="font-weight: 300;">
        blog
      </h1>
      <p class="text-text-silver mt-3 text-sm font-light italic">things I've written down</p>
    </div>

    <div class="space-y-6">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${idToSlug(post.id)}/`}
            class="fade-up group relative block overflow-hidden rounded-lg px-3 py-3 m-[-0.75rem] transition-[transform,box-shadow] duration-300 motion-reduce:hover:transform-none motion-reduce:hover:shadow-none motion-reduce:group-hover:border-accent motion-reduce:group-hover:border-solid motion-reduce:group-hover:border-2 hover:translate-y-[-2px] hover:shadow-[0_4px_24px_rgba(167,139,250,0.08)] border-transparent border-0"
            style={{ animationDelay: `${i * 0.05}s` }}
          >
            {post.data.coverImage && (
              <div class="relative h-[180px] w-full overflow-hidden">
                <Image
                  src={post.data.coverImage}
                  alt=""
                  width={800}
                  height={400}
                  class="h-full w-full object-cover motion-reduce:group-hover:scale-100 transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 via-transparent motion-reduce:animation-none cover-image-overlay" />
              </div>
            )}
            <div class="px-1 py-3">
              <time class="text-text-dim text-sm">{formatDate(post.data.date)}</time>
              <h2 class="text-silver-light mt-1 mb-2 text-xl font-semibold">{post.data.title}</h2>
              <p class="text-text-muted leading-relaxed">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="text-text-dim italic">No posts yet. Something will appear eventually.</p>
      )
    }
  </div>
</Layout>
