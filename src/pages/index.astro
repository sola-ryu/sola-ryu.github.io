---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgImage from '../assets/moonlit-night.png';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestPost = posts[0];
const nextPosts = posts.slice(1, 4);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function slugToPath(id: string): string {
  return '/blog/' + id.replace(/^blog:/, '') + '/';
}
---

<Layout title="Home" currentPage="home">
  <!-- Hero -->
  <div class="relative h-[280px] w-full overflow-hidden">
    <Image
      src={bgImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[center_25%]"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, #08080d 0%, rgba(8,8,13,0.4) 50%, #08080d 100%);"
    ></div>
    <div class="absolute inset-0 z-10 flex items-center justify-center">
      <span class="text-silver-light/50 font-mono text-[11px] tracking-[0.3em] uppercase">
        sola di ryuvia
      </span>
    </div>
  </div>

  <!-- Main content -->
  <div class="mx-auto max-w-2xl px-6 pt-14 pb-20 md:pt-20 md:pb-28">
    <!-- Title -->
    <div class="mb-14 fade-up">
      <h1 class="text-silver-light/40 text-[64px] leading-[0.9] font-light tracking-tight select-none md:text-[88px] lg:text-[112px]">
        <span class="title-letter inline-block contrast-more:!text-silver-light contrast-more:!opacity-100">s</span>
        <span class="title-letter inline-block contrast-more:!text-silver-light contrast-more:!opacity-100">o</span>
        <span class="title-letter inline-block contrast-more:!text-silver-light contrast-more:!opacity-100">l</span>
        <span class="title-letter inline-block contrast-more:!text-silver-light contrast-more:!opacity-100">a</span>
        <span class="text-xl ml-2 align-middle">🌙</span>
      </h1>
    </div>

    <div class="divider my-8"></div>

    <!-- Navigation -->
    <div class="mb-16 grid grid-cols-2 gap-8 md:gap-12">
      <div>
        <div class="text-text-dim mb-4 font-mono text-[9px] tracking-[0.2em] uppercase">
          navigate
          <span class="bg-accent/30 absolute top-1/2 left-0 h-px w-3 -translate-y-1/2"></span>
        </div>
        <ul class="space-y-2">
          <li>
            <a
              href="/blog/"
              class="text-text-muted hover:text-accent border-accent/[0.1] hover:border-accent/40 inline-flex items-center gap-2 border-b pb-0.5 text-[15px] transition-colors duration-200"
            >
              Blog <span class="-translate-x-1 text-[11px] opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100">&rarr;</span>
            </a>
          </li>
          <li>
            <a
              href="/dreams/"
              class="text-text-muted hover:text-accent border-accent/[0.1] hover:border-accent/40 inline-flex items-center gap-2 border-b pb-0.5 text-[15px] transition-colors duration-200"
            >
              Dreams <span class="-translate-x-1 text-[11px] opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100">&rarr;</span>
            </a>
          </li>
          <li>
            <a
              href="/about/"
              class="text-text-muted hover:text-accent border-accent/[0.1] hover:border-accent/40 inline-flex items-center gap-2 border-b pb-0.5 text-[15px] transition-colors duration-200"
            >
              About <span class="-translate-x-1 text-[11px] opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100">&rarr;</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-text-dim mb-4 font-mono text-[9px] tracking-[0.2em] uppercase">
          latest
          <span class="bg-accent/30 absolute top-1/2 left-0 h-px w-3 -translate-y-1/2"></span>
        </div>
        {latestPost ? (
          <div class="space-y-4">
            <a
              href={slugToPath(latestPost.id)}
              class="text-silver hover:text-accent border-accent/[0.15] hover:border-accent/40 inline-block border-b pb-0.5 text-[16px] transition-colors duration-200"
            >
              {latestPost.data.title}
            </a>
            <div class="text-text-dim/60 pl-6 font-mono text-[10px]">
              {formatDate(latestPost.data.date)} ·{' '}
              {Math.ceil((latestPost.body.length || 0) / 1400)} min read
            </div>
          </div>
        ) : (
          <div class="text-text-dim pl-6 text-[15px]">nothing yet</div>
        )}
      </div>
    </div>

    <div class="divider my-10"></div>

    <!-- Recent posts -->
    {nextPosts.length > 0 && (
      <div class="mb-16 fade-up fade-up-delay-1">
        <div class="text-text-dim mb-6 font-mono text-[9px] tracking-[0.2em] uppercase">
          also recent
        </div>
        <ul class="space-y-2">
          {nextPosts.map((post) => (
            <li>
              <a
                href={slugToPath(post.id)}
                class="text-text-muted hover:text-accent border-accent/[0.08] hover:border-accent/30 inline-flex items-center gap-2 border-b pb-0.5 text-[14px] transition-colors duration-200"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Footer tagline -->
    <div class="text-text-dim/30 pb-4 text-center font-mono text-[10px] tracking-widest uppercase">
      content first, low noise, stable reading rhythm
    </div>
  </div>
</Layout>
