---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bgImage from '../../assets/moonlit-night.png';

const dreams = (await getCollection('dreams'))
  .filter((d) => !d.data.draft)
  .sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

function idToSlug(id: string): string {
  return id.replace(/^dreams:/, '');
}

// Group dreams by year-month (ISO key for deterministic ordering)
const monthGroups: Record<string, typeof dreams> = {};
dreams.forEach((d) => {
  const date = new Date(d.data.date);
  const key = date.toISOString().slice(0, 7);
  if (!monthGroups[key]) monthGroups[key] = [];
  monthGroups[key].push(d);
});

const sortedMonths = Object.keys(monthGroups).sort((a, b) => b.localeCompare(a));

function formatMonthHeading(key: string): string {
  return new Date(key + '-01T00:00:00').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
}
---
<Layout title="Dreams" currentPage="dreams">
  <Image
    src={bgImage}
    alt=""
    class="fixed inset-0 z-0 h-full w-full object-cover contrast-more:hidden"
    style={{ pointerEvents: 'none' }}
  />
  <div class="fixed inset-0 z-0 h-full w-full bg-linear-(--dreams-overlay) bg-size-[110rem] bg-center"></div>
  <div class="relative z-10 mx-auto max-w-2xl px-6 pt-32 pb-20 md:pt-40 md:pb-28 text-center">
    <div class="fade-up mb-12">
      <h1 class="text-silver-light text-3xl font-light tracking-tight md:text-4xl">dreams</h1>
      <p class="text-text-silver mt-3 text-sm font-light italic">things I remember from sleeping</p>
    </div>

    <div class="space-y-12 text-left">
      {sortedMonths.map((monthKey) => (
        <div class="fade-up">
          <h2 class="text-sm font-medium text-slate-500 tracking-widest uppercase mb-4 border-b border-slate-800 pb-2">
            {formatMonthHeading(monthKey)}
          </h2>
          <div class="grid grid-cols-4 gap-x-3 gap-y-2">
            {monthGroups[monthKey].map((dream) => (
              <a
                href={`/dreams/${idToSlug(dream.id)}/`}
                class="text-xs font-mono text-cyan-500/80 hover:opacity-85 transition-opacity"
              >
                {new Date(dream.data.date).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                })}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    {dreams.length === 0 && <p class="text-text-dim/60 mt-8 text-sm italic">still dreaming</p>}
  </div>
</Layout>
